---
import { siteAssetVersion } from '../lib/site-shell';
import { SITE_URL } from '../lib/config';
import '../styles/tailwind.css';

const {
  title,
  description,
  canonicalPath,
  robots = 'index,follow,max-image-preview:large',
  socialImagePath = '/img/logo.png',
  socialImageAlt = 'ifsc.stream',
  bodyClass = 'bg-background text-on-background min-h-screen',
  pageType,
  updatedAt,
  bodyData = {},
} = Astro.props;

const canonicalUrl = `${SITE_URL}${canonicalPath}`;
const socialImageUrl = socialImagePath.startsWith('http')
  ? socialImagePath
  : `${SITE_URL}${socialImagePath}`;
---
<!doctype html>
<html lang="en">
<head>
    <script>document.documentElement.classList.add('dark');</script>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <base href="/" />
    <link rel="canonical" href={canonicalUrl} />
    <slot name="head-preload" />
    <link rel="preload" href={`/fonts/plus-jakarta-sans-variable.woff2?v=${siteAssetVersion}`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`/fonts/space-grotesk-variable.woff2?v=${siteAssetVersion}`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`/fonts/material-symbols-outlined.woff2?v=${siteAssetVersion}`} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://cal.ifsc.stream" />
    <link rel="preconnect" href="https://img.youtube.com" />

    <link rel="stylesheet" href={`/css/modals.css?v=${siteAssetVersion}`} />

    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: rgb(var(--color-background)); color: rgb(var(--color-on-background)); }
        .font-headline { font-family: 'Space Grotesk', sans-serif; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: rgb(var(--color-background)); }
        ::-webkit-scrollbar-thumb { background: rgb(var(--color-surface-variant)); border-radius: 4px; }
    </style>

    <slot name="head" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="ifsc.stream" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <script type="application/ld+json" id="structured-data-organization">
        {
            "@context": "https://schema.org",
            "@type": "Organization",
            "@id": "https://ifsc.stream/#organization",
            "name": "ifsc.stream",
            "url": "https://ifsc.stream/",
            "logo": "https://ifsc.stream/img/logo.png",
            "sameAs": [
                "https://github.com/sportclimbing/ifsc-calendar",
                "https://www.instagram.com/nicoswd/"
            ]
        }
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon.svg" id="favicon" />
</head>
<body class={bodyClass} data-page-type={pageType} data-build-version={siteAssetVersion} data-updated-at={updatedAt} {...bodyData}>

<slot />

<script is:inline src={`/js/dayjs.min.js?v=${siteAssetVersion}`}></script>
<script is:inline src={`/js/bootstrap.min.js?v=${siteAssetVersion}`}></script>
<script is:inline src={`/js/app.js?v=${siteAssetVersion}`}></script>
<slot name="body-end" />
</body>
</html>
