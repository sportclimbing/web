---
// Static page hero matching HeroSection.astro's visual shell, without the
// live-JS contract (countdown, status badge, details button, next-event-* ids).
// Title can be passed via the `title` prop or as slot children for markup
// like highlighted <span class="text-primary"> segments.
const {
  title = '',
  badgeLabel = '',
  badgeIcon = '',
  subtitle = '',
  bgImage = '/img/hero/hero-bg.webp',
  bgPosition = 'center 30%',
} = Astro.props;

const bgMobile = bgImage === '/img/hero/hero-bg.webp' ? '/img/hero/hero-bg-mobile.webp' : null;
---
<section class="relative w-full h-[280px] lg:h-[500px] overflow-hidden flex items-center">
    <div class="absolute inset-0 z-0">
        <picture>
            {bgMobile && <source media="(max-width: 1023px)" srcset={bgMobile} />}
            <img src={bgImage} alt="" aria-hidden="true" fetchpriority="high" loading="eager" decoding="async" class="absolute inset-0 w-full h-full object-cover opacity-60" style={`object-position: ${bgPosition};`} />
        </picture>
        <div class="absolute inset-0 bg-gradient-to-t from-background via-background/55 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-5xl mx-auto px-6 w-full">
        {badgeLabel && (
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-tertiary text-on-tertiary rounded-full mb-6">
                {badgeIcon && <span class="material-symbols-outlined text-base leading-none">{badgeIcon}</span>}
                <span class="text-[0.5rem] lg:text-[0.6875rem] font-bold tracking-widest uppercase font-label">{badgeLabel}</span>
            </div>
        )}
        <h1 class="text-4xl md:text-8xl font-black font-headline tracking-tighter mb-4 uppercase leading-[0.9] line-clamp-2 md:line-clamp-none">
            <slot>{title}</slot>
        </h1>
        {subtitle && (
            <p class="font-body text-on-surface-variant text-sm lg:text-base max-w-xl leading-relaxed">{subtitle}</p>
        )}
    </div>
</section>
