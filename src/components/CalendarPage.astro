---
import { extract_youtube_video_id } from '../lib/shared/media';
import BaseLayout from '../layouts/BaseLayout.astro';
import AppHeader from './AppHeader.astro';
import AppFooter from './AppFooter.astro';
import EventCards from './EventCards.astro';
import Modals from './Modals.astro';
import VideoModal from './VideoModal.astro';
import CardTemplates from './CardTemplates.astro';
import HeroSection from './HeroSection.astro';
import CookieConsent from './CookieConsent.astro';
import CalendarSyncBanner from './CalendarSyncBanner.astro';
import SeasonMonthNav from './SeasonMonthNav.astro';
import { build_event_page_path } from '../lib/event-pages';
import { round_will_be_streamed } from '../js/app/helpers/core.js';
import { HERO_BG_OVERRIDES } from '../lib/config';

const {
  season,
  seasons,
  eventsPayload,
  canonicalPath,
  pageTitle,
  pageDescription,
  robotsContent = 'index,follow,max-image-preview:large',
  socialImagePath = '/img/logo.png',
  socialImageAlt = 'ifsc.stream season calendar preview',
} = Astro.props;

const normalizedSeason = String(season);
const normalizedSeasons = Array.isArray(seasons) ? seasons.map(String) : [];
const events = Array.isArray(eventsPayload?.events) ? eventsPayload.events : [];
const updatedAt = eventsPayload?.metadata?.updated_at || undefined;

// Find next/live event
const now = new Date();
let nextEvent = null;
let liveEvent = null;
let lastEvent = null;

for (const event of events) {
    const rounds = event.rounds;
    for (const round of rounds) {
        if (!round_will_be_streamed(round, event) || event.league_name === 'Games') {
            continue;
        }

        const startsAt = new Date(round.starts_at);
        const endsAt = new Date(round.ends_at);

        if (now >= startsAt && now <= endsAt) {
            liveEvent = { ...event, currentRound: round };
            break;
        }
        if (startsAt > now) {
            if (!nextEvent || startsAt < new Date(nextEvent.currentRound.starts_at)) {
                nextEvent = { ...event, currentRound: round };
            }
        } else if (!nextEvent && (!lastEvent || startsAt > new Date(lastEvent.currentRound.starts_at))) {
            lastEvent = { ...event, currentRound: round };
        }
    }
    if (liveEvent) break;
}

const heroEvent = liveEvent || nextEvent || lastEvent;

const heroEventRounds = Array.isArray(heroEvent?.rounds) ? heroEvent.rounds : [];
const heroRound = heroEvent?.currentRound || heroEventRounds[heroEventRounds.length - 1];
const heroEventTitle = heroEvent?.name || `World Climbing Series ${normalizedSeason}`;
const heroRoundName = heroRound?.name || '';
const heroEventPagePath = build_event_page_path(normalizedSeason, heroEvent);

const firstStreamUrl = events
    .flatMap((e) => Array.isArray(e.rounds) ? e.rounds : [])
    .map((r) => r.stream_url)
    .find((url) => url && extract_youtube_video_id(url));
const heroBgVideoId = firstStreamUrl ? extract_youtube_video_id(firstStreamUrl) : null;
const seasonOverride = HERO_BG_OVERRIDES[normalizedSeason] || {};
const resolvedBgVideoId = seasonOverride.youTubeVideoId ?? heroBgVideoId;
const heroBgImage = resolvedBgVideoId
    ? `https://img.youtube.com/vi/${resolvedBgVideoId}/maxresdefault.jpg`
    : '/img/hero/hero-bg.webp';
const heroBgIsDefault = !resolvedBgVideoId;
const heroBgPosition = seasonOverride.backgroundPosition ?? null;
---
<BaseLayout
    title={pageTitle}
    description={pageDescription}
    canonicalPath={canonicalPath}
    robots={robotsContent}
    socialImagePath={socialImagePath}
    socialImageAlt={socialImageAlt}
    pageType="season"
    updatedAt={updatedAt}
>
    {heroBgIsDefault ? (
        <link slot="head-preload" rel="preload" as="image" fetchpriority="high" imagesrcset="/img/hero/hero-bg-mobile.webp 800w, /img/hero/hero-bg.webp 1280w" imagesizes="100vw" />
    ) : (
        <link slot="head-preload" rel="preload" href={heroBgImage} as="image" fetchpriority="high" />
    )}
    <style slot="head">
        .glass-panel { background: rgb(var(--color-background) / 0.7); backdrop-filter: blur(20px); }
        .kinetic-gradient { background: linear-gradient(135deg, #97CCFF 0%, #66B2F2 100%); }
        .discipline-quick-filter[data-active="true"] {
            background-color: rgb(var(--color-primary) / 0.18);
            color: rgb(var(--color-primary));
            border-color: rgb(var(--color-primary) / 0.6);
            box-shadow: 0 0 12px rgb(var(--color-primary) / 0.15) inset;
        }
        .discipline-quick-filter[data-active="true"]:hover {
            background-color: rgb(var(--color-primary) / 0.25);
        }
        @media (min-width: 1024px) {
            #filter-bar .filter-bar-breadcrumb {
                max-width: 320px;
                opacity: 1;
                overflow: hidden;
                transition: max-width 0.3s ease, opacity 0.2s ease;
            }
            #filter-bar.is-stuck {
                width: fit-content;
                margin-left: auto;
            }
            #filter-bar.is-stuck .filter-bar-breadcrumb {
                max-width: 0;
                opacity: 0;
            }
            #filter-bar .filter-bar-inner {
                transition: background-color 0.3s ease;
            }
            #filter-bar.is-stuck .filter-bar-inner {
                background-color: rgb(var(--color-surface-container-highest));
                gap: 0;
            }
        }
    </style>

<AppHeader />

<main role="main">
    <!-- Hero Section: Next Event -->
    <HeroSection
        heroEventTitle={heroEventTitle}
        heroRound={heroRound}
        heroRoundName={heroRoundName}
        leagueName={heroEvent?.league_name}
        eventId={heroEvent?.id}
        eventPagePath={heroEventPagePath}
        heroBgImage={heroBgImage}
        heroBgPosition={heroBgPosition}
    />

    <!-- Main Content Area with Side Nav -->
    <div class="max-w-screen-2xl mx-auto px-3 sm:px-6 pt-0 lg:pt-8 flex gap-8 lg:gap-12 relative" id="accordion">
        <!-- Sticky Vertical Navigation -->
        <SeasonMonthNav season={normalizedSeason} seasons={normalizedSeasons} />

        <!-- Events Content -->
        <div class="flex-1 lg:max-w-[75%] pb-24">
            <!-- Filter & Search Bar -->
            <div id="filter-bar-sentinel" aria-hidden="true"></div>
            <section id="filter-bar" class="mb-4 lg:mb-4 lg:sticky lg:top-[72px] z-30">
                <div class="filter-bar-inner bg-surface-container-low/75 backdrop-blur-xl border border-outline-variant/25 p-2 rounded-2xl shadow-lg shadow-black/20 flex flex-col md:flex-row justify-between items-center gap-2 md:gap-4">
                    <nav aria-label="Breadcrumb" class="filter-bar-breadcrumb w-full md:w-auto">
                        <div class="grid grid-cols-[auto_1fr] lg:flex items-center gap-1 lg:gap-2 p-1 bg-surface-container-lowest/80 rounded-xl w-full md:w-auto">
                            <a href="/" aria-label="Home" class="flex items-center justify-center gap-1.5 px-3 lg:px-4 py-2 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 rounded-lg transition-colors uppercase text-xs tracking-widest font-bold">
                                <span class="material-symbols-outlined text-sm leading-none">home</span>
                                <span class="hidden lg:inline">Home</span>
                            </a>
                            <div class="relative min-w-0">
                                <select id="season-selector-mobile" name="season-selector" aria-label="Season" class="lg:hidden opacity-0 absolute inset-0 w-full h-full cursor-pointer z-10">
                                    {normalizedSeasons.map((s) => (
                                        <option value={s} selected={s === normalizedSeason}>{s} Season</option>
                                    ))}
                                </select>
                                <button class="w-full lg:w-auto px-4 lg:px-6 py-2 bg-primary text-on-primary font-bold rounded-lg uppercase text-xs tracking-widest shadow-md shadow-primary/25 flex items-center justify-center gap-1 whitespace-nowrap" aria-current="page">{normalizedSeason} Season <span class="material-symbols-outlined text-sm leading-none lg:hidden">expand_more</span></button>
                            </div>
                        </div>
                    </nav>
                    <div class="flex flex-nowrap items-center justify-center gap-1 p-1 bg-surface-container-lowest/80 rounded-xl w-full md:w-auto">
                        <button class="discipline-quick-filter flex-1 md:flex-none px-3 py-1.5 lg:py-[5px] lg:px-4 border border-transparent text-on-surface-variant rounded-lg text-xs lg:text-sm font-medium hover:bg-surface-container-high transition-colors" data-quick-filter="boulder">Boulder</button>
                        <button class="discipline-quick-filter flex-1 md:flex-none px-3 py-1.5 lg:py-[5px] lg:px-4 border border-transparent text-on-surface-variant rounded-lg text-xs lg:text-sm font-medium hover:bg-surface-container-high transition-colors" data-quick-filter="lead">Lead</button>
                        <button class="discipline-quick-filter flex-1 md:flex-none px-3 py-1.5 lg:py-[5px] lg:px-4 border border-transparent text-on-surface-variant rounded-lg text-xs lg:text-sm font-medium hover:bg-surface-container-high transition-colors" data-quick-filter="speed">Speed</button>
                        <div class="h-4 w-px bg-outline-variant mx-1"></div>
                        <button class="flex-1 md:flex-none px-3 py-1.5 lg:py-[5px] lg:px-4 border border-primary/35 text-primary rounded-lg text-xs lg:text-sm font-medium hover:bg-primary/10 transition-colors flex items-center justify-center gap-1.5 lg:gap-2 filters-button" data-open-filter-modal>
                            <span class="material-symbols-outlined text-sm">filter_list</span> Filters
                        </button>
                    </div>
                </div>
            </section>

            <!-- Event Calendar -->
            <section aria-labelledby="events-section-heading">
                <h2 id="events-section-heading" class="sr-only">Season Events</h2>
                <div class="grid grid-cols-1 gap-4 lg:gap-10">
                    <EventCards events={events} linkEventTitles={true} hideRounds={true} hideScheduleStatusOnMobile={true} showMobileDetailsButton={true} hideInfosheetOnMobile={true} />
                </div>
            </section>
        </div>
    </div>

    <CalendarSyncBanner />
</main>


<!-- Background Decoration -->
<div class="fixed top-0 left-0 w-full h-full pointer-events-none -z-10 overflow-hidden">
    <div class="absolute top-[-10%] left-[-5%] w-[800px] h-[800px] bg-primary/5 rounded-full blur-[150px]"></div>
    <div class="absolute bottom-[5%] right-[-10%] w-[600px] h-[600px] bg-tertiary/5 rounded-full blur-[150px]"></div>
</div>

<Modals />
<VideoModal />
<CardTemplates />

<AppFooter />
<CookieConsent />
</BaseLayout>