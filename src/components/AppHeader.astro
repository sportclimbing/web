---
---
<nav class="sticky top-0 w-full z-50 bg-background/80 backdrop-blur-xl border-b border-outline-variant/10">
    <div class="flex items-center justify-between px-3 lg:px-6 py-4 max-w-screen-2xl mx-auto w-full">
        <div class="flex items-center gap-2 lg:gap-4">

            <a class="text-primary px-3 py-[7px] rounded-lg font-headline font-bold text-sm tracking-tighter transition-transform hover:scale-[1.02] active:scale-95 flex items-center gap-2 whitespace-nowrap" href="https://www.instagram.com/nicoswd/" target="_blank" onclick="window.gtag && gtag('event', 'instagram_clicked')">
                <span class="instagram-icon inline-block" style="width:22px;height:22px;"></span>
            </a>
            <a class="hidden md:flex text-primary px-3 py-[7px] rounded-lg font-headline font-bold text-sm tracking-tighter transition-transform hover:scale-[1.02] active:scale-95 items-center gap-2 whitespace-nowrap" href="https://github.com/sportclimbing" target="_blank" onclick="window.gtag && gtag('event', 'github_clicked')">
                <span class="github-icon inline-block" style="width:20px;height:20px;"></span>
            </a>
        </div>
        <!-- lg margin aligns right edge with events column: 75% of container minus side nav (192px) + gap (48px) -->
        <div class="flex items-center gap-2 lg:gap-4 lg:mr-[calc(25%-240px)]">
            <button class="bg-primary text-on-primary px-4 py-2 rounded-lg font-headline font-bold text-sm uppercase tracking-tighter transition-transform hover:scale-[1.02] active:scale-95 flex items-center gap-2 whitespace-nowrap calendar-sync-tooltip" data-open-calendar-modal>
                <span class="material-symbols-outlined text-sm">sync</span>
                <span><span class="hidden sm:inline">Sync with </span>Calendar</span>
            </button>
            <a class="bg-tertiary text-on-tertiary px-4 py-2 rounded-lg font-headline font-bold text-sm uppercase tracking-tighter transition-transform hover:scale-[1.02] active:scale-95 flex items-center gap-2 whitespace-nowrap" href="https://www.buymeacoffee.com/sportclimbing" target="_blank" onclick="window.gtag && gtag('event', 'buy_me_a_coffee_clicked')">
                <span class="material-symbols-outlined text-sm">local_cafe</span>
                <span class="hidden md:inline">Buy me a Coffee</span>
            </a>
        </div>
    </div>
</nav>
