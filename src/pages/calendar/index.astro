---
import '../../styles/tailwind.css';
import AppHeader from '../../components/AppHeader.astro';
import AppFooter from '../../components/AppFooter.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import CalendarConfigPage from '../../components/CalendarConfigPage.astro';
import { DEFAULT_SEASON } from '../../lib/config.js';
import { siteAssetVersion } from '../../lib/site-shell.js';

const season = DEFAULT_SEASON;
const pageTitle = `Subscribe to the IFSC Climbing Calendar ${season} — Boulder, Lead & Speed | ifsc.stream`;
const pageDescription = `Add the IFSC World Cup ${season} schedule to Apple Calendar, Google Calendar or Outlook. Auto-syncing iCal subscription — filter by discipline, round and category.`;
const canonicalUrl = 'https://ifsc.stream/calendar/';
const socialImageUrl = `https://ifsc.stream/img/season/${season}.svg`;
const socialImageAlt = `World Climbing ${season} calendar subscription`;

const breadcrumbStructuredData = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ifsc.stream/' },
        { '@type': 'ListItem', position: 2, name: 'Calendar Sync', item: canonicalUrl },
    ],
};

const howToStructuredData = {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: `Subscribe to the IFSC climbing calendar ${season}`,
    description: `Add the IFSC World Cup ${season} schedule to your calendar app so it stays in sync automatically.`,
    step: [
        {
            '@type': 'HowToStep',
            name: 'Customize the events (optional)',
            text: 'Open Customize to pick which series, categories, disciplines (Boulder, Lead, Speed) and round types are included in your calendar.',
            url: `${canonicalUrl}#customize-toggle`,
        },
        {
            '@type': 'HowToStep',
            name: 'Choose a calendar provider',
            text: 'Click Apple & Outlook to add the calendar to a native app, or Google Calendar to add it on the web. You can also copy the subscription URL and paste it into your app’s "Subscribe from URL" option.',
            url: canonicalUrl,
        },
        {
            '@type': 'HowToStep',
            name: 'Stay in sync',
            text: 'Confirm the subscription. Your calendar auto-updates as the IFSC schedule changes — add once, stay in sync.',
            url: canonicalUrl,
        },
    ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
    <script>document.documentElement.classList.add('dark');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <base href="/" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon.svg" id="favicon" />

    <link rel="preload" href={`/fonts/plus-jakarta-sans-variable.woff2?v=${siteAssetVersion}`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`/fonts/space-grotesk-variable.woff2?v=${siteAssetVersion}`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`/fonts/material-symbols-outlined.woff2?v=${siteAssetVersion}`} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://cal.ifsc.stream" />

    <link rel="stylesheet" href={`/css/modals.css?v=${siteAssetVersion}`} />

    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: rgb(var(--color-background)); color: rgb(var(--color-on-background)); }
        .font-headline { font-family: 'Space Grotesk', sans-serif; }
        .kinetic-gradient { background: linear-gradient(135deg, #97CCFF 0%, #66B2F2 100%); }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: rgb(var(--color-background)); }
        ::-webkit-scrollbar-thumb { background: rgb(var(--color-surface-variant)); border-radius: 4px; }
    </style>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="ifsc.stream" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <script type="application/ld+json" id="structured-data-organization">
        {
            "@context": "https://schema.org",
            "@type": "Organization",
            "@id": "https://ifsc.stream/#organization",
            "name": "ifsc.stream",
            "url": "https://ifsc.stream/",
            "logo": "https://ifsc.stream/img/logo.png",
            "sameAs": [
                "https://github.com/sportclimbing/ifsc-calendar",
                "https://www.instagram.com/nicoswd/"
            ]
        }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToStructuredData)} />

    <script defer src={`/js/app.js?v=${siteAssetVersion}`}></script>
</head>
<body class="bg-surface min-h-screen flex flex-col font-body text-on-surface antialiased" data-page-type="config">
    <AppHeader season={season} />
    <main class="flex-1">
        <CalendarConfigPage season={season} />
    </main>
    <AppFooter season={season} />
    <CookieConsent />
</body>
</html>
